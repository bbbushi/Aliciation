{
  "version": 38,
  "stage": "macos-arm64-updater-development-bundle",
  "include": [
    {
      "source": "alice",
      "target": "alice",
      "extensions": [
        ".py",
        ".json"
      ]
    },
    {
      "source": "web",
      "target": "web",
      "extensions": [
        ".html",
        ".js",
        ".css",
        ".png",
        ".jpg",
        ".jpeg",
        ".svg",
        ".webp",
        ".ico",
        ".woff",
        ".woff2"
      ]
    },
    {
      "source": "config.example.toml",
      "target": "config.example.toml"
    }
  ],
  "excludeDirectories": [
    "__pycache__",
    ".venv",
    "node_modules",
    "user",
    ".git"
  ],
  "excludeTargets": [
    "alice/evaluation.py",
    "alice/evaluation_service.py",
    "web/observer.js",
    "web/evaluations.js",
    "web/context-viewer.js",
    "web/context-viewer.css"
  ],
  "components": {
    "core": "packaged",
    "context-inspector": "external-alice-lab",
    "p1-evaluation": "external-alice-lab-source-runner",
    "discovery-worker": "packaged",
    "profile-maintenance": "packaged",
    "qq": "not-packaged",
    "browser-reader": "not-packaged",
    "bilibili": "not-packaged",
    "claude-agent": "not-packaged",
    "dsh-agent": "not-packaged",
    "updater": "scheduled-check-manual-install-signed-macos",
    "desktop-bubble": "macos-shortcut-hub-following-source-projection",
    "autonomous-activity": "normal-lifecycle-with-lab-socket-compatible-observation",
    "web-search": "normal-quotas",
    "reply-sections": "gui-contextual-comment-lines",
    "reply-annotation-review": "not-enabled-in-desktop",
    "reply-sections-observation": "external-read-only-authorized"
  }
}
