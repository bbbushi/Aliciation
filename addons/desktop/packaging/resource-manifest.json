{
  "version": 4,
  "stage": "macos-arm64-private-updater-development-bundle",
  "include": [
    {"source": "alice", "target": "alice", "extensions": [".py", ".json"]},
    {"source": "web", "target": "web", "extensions": [".html", ".js", ".css", ".png", ".jpg", ".jpeg", ".svg", ".webp", ".ico", ".woff", ".woff2"]},
    {"source": "addons/context_inspector", "target": "addons/context_inspector", "extensions": [".json", ".html", ".js", ".css"]},
    {"source": "config.example.toml", "target": "config.example.toml"}
  ],
  "excludeDirectories": ["__pycache__", ".venv", "node_modules", "user", ".git"],
  "components": {
    "core": "packaged",
    "context-inspector": "packaged",
    "discovery-worker": "packaged",
    "profile-maintenance": "packaged",
    "qq": "not-packaged",
    "browser-reader": "not-packaged",
    "bilibili": "not-packaged",
    "claude-agent": "not-packaged",
    "dsh-agent": "not-packaged",
    "updater": "manual-check-signed-private-macos"
  }
}
