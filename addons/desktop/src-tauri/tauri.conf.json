{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Alice",
  "version": "0.1.37",
  "identifier": "app.aliceharness.desktop",
  "build": {
    "frontendDist": "../bootstrap"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "capabilities": [
        {
          "identifier": "bubble-local",
          "windows": [
            "bubble-anchor",
            "bubble-actions",
            "bubble-settings",
            "bubble-appearance",
            "bubble-quit"
          ],
          "permissions": [
            "allow-bubble-action"
          ]
        },
        {
          "identifier": "updates-local",
          "windows": [
            "updates"
          ],
          "permissions": [
            "allow-update-action"
          ]
        },
        {
          "identifier": "maintenance-local",
          "windows": [
            "maintenance"
          ],
          "permissions": [
            "allow-maintenance-action"
          ]
        }
      ],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png"
    ],
    "targets": [
      "app"
    ],
    "shortDescription": "Alice 本机陪伴应用"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENENzhGNEFEMzJFNzI4MUQKUldRZEtPY3lyZlI0elY5c2RtR1ZQOUUrRVphaFVKVDV3Zm5BOE5EZzkvaGZ3aXkzSXVaQTJaSm8K",
      "endpoints": [
        "https://github.com/bbbushi/Aliciation/releases/download/desktop-dev/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
