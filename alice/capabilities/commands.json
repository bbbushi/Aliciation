            ]
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      },
      "internal": {
        "executor": "history",
        "operation": "history_search"
      }
    },
    {
      "command": "history_load",
      "summary": "读取本轮历史引用的完整往返；读取额度独立于搜索，总字数预算共用。",
      "parameters": {
        "type": "object",
        "properties": {
          "refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 2
          }
        },
        "required": [
          "refs"
        ],
        "additionalProperties": false
      },
      "internal": {
        "executor": "history",
        "operation": "history_load"
      }
    },
    {
      "command": "context_keep",
      "summary": "提议跨轮保留本轮已读取的普通记忆。",
      "parameters": {
        "type": "object",
        "properties": {
          "refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 4
          }
        },
        "required": [
          "refs"
        ],
        "additionalProperties": false
      },
      "internal": {
        "executor": "workspace",
        "operation": "context_keep"
      }
    },
    {
      "command": "context_release",
      "summary": "移出跨轮工作集中的指定条目。",
      "parameters": {
        "type": "object",
        "properties": {
          "refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 8
          }
        },
        "required": [
          "refs"
        ],
        "additionalProperties": false
      },
      "internal": {
        "executor": "workspace",
        "operation": "context_release"
      }
    },
    {
      "command": "persona_load",
      "summary": "读取与当前情境相关的人格场景材料。",
      "parameters": {
        "type": "object",
        "properties": {
          "refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 2
          }
        },
        "required": [
          "refs"
        ],
        "additionalProperties": false
      },
      "internal": {
        "executor": "persona",
        "operation": "persona_load"
      }
    },
    {
      "command": "dispatch_worker",
      "summary": "向已授权协作者派发有界任务。",
      "parameters": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "dsh-agent",
              "claude-agent"
            ]
          },
          "brief": {
            "type": "string",
            "maxLength": 10000,
            "description": "具体任务、约束及完成标准；最多 10000 UTF-8 字节。文件用 GUI 授权目录中的相对路径说明。"
          },
          "title": {
            "type": "string",
            "maxLength": 80
          },
          "input_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 0,
            "description": "本阶段只能传空数组；使用 GUI 中已授权的任务目录，不支持导入文件。"
          },
          "requested_outputs": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "string",
              "maxLength": 200
            },
            "description": "期望文件名或产物描述；只转述给协作者，不保证文件已收取或验证。"
          }
        },
        "required": [
          "name",
          "brief",
          "input_ids",
          "requested_outputs"
        ],
        "additionalProperties": false
      },
      "internal": {
        "executor": "worker",
        "operation": "dispatch_worker"
      }
    },
    {
      "command": "worker_task_status",
      "summary": "查询协作任务的实际状态。",
      "parameters": {
        "type": "object",
        "properties": {
          "task_ids": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string",
              "description": "宿主返回的 task_id，不得猜测或使用协作者的原生会话 ID。"
            },
            "description": "可选；省略或空数组时列出当前 GUI 的任务状态。"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "internal": {
        "executor": "worker",
        "operation": "worker_task_status"
      }
    },
    {
      "command": "worker_task_read",
      "summary": "读取指定协作任务的公开回复。",
      "parameters": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string",
            "description": "宿主返回的 task_id，不得猜测或使用协作者的原生会话 ID。"
          },
          "after_message_id": {
            "type": "string",
            "description": "可选；从上次返回的消息 ID 之后继续读取。"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          }
        },
        "required": [
          "task_id"
        ],
        "additionalProperties": false
      },
      "internal": {
        "executor": "worker",
        "operation": "worker_task_read"
      }
    },
    {
      "command": "send_worker_message",
      "summary": "向原DSH任务发送补充或追问。",
      "parameters": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string",
            "description": "宿主返回的 task_id，不得猜测或使用协作者的原生会话 ID。"
          },
          "message": {
            "type": "string",
            "maxLength": 10000,
            "description": "补充说明，最多 10000 UTF-8 字节；文件用已授权目录中的相对路径。"
          },
          "input_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 0,
            "description": "本阶段只能传空数组；使用 GUI 中已授权的任务目录，不支持导入文件。"
          }
        },
        "required": [
          "task_id",
          "message"
        ],
        "additionalProperties": false
      },
      "internal": {
        "executor": "worker",
        "operation": "send_worker_message"
      }
    },
    {
      "command": "cancel_worker_task",
      "summary": "请求停止指定协作任务。",
      "parameters": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string",
            "description": "宿主返回的 task_id，不得猜测或使用协作者的原生会话 ID。"
          }
        },
        "required": [
          "task_id"
        ],
        "additionalProperties": false
      },
      "internal": {
        "executor": "worker",
        "operation": "cancel_worker_task"
      }
    },
