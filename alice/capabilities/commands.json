    {
      "command": "thought_search",
      "summary": "检索思想层的疑问与当前思辨索引。",
      "parameters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 500
          },
          "include_closed": {
            "type": "boolean"
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      },
      "internal": {
        "executor": "thought",
        "operation": "thought_search"
      }
    },
    {
      "command": "thought_load",
      "summary": "读取任务摘要或按需展开旧推演/观点；默认task不载入旧正文。",
      "parameters": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "detail": {
            "type": "string",
            "enum": [
              "task",
              "full"
            ],
            "description": "疑问默认task，仅任务题目与状态；要旧进展/推演/出处正文时选full并绑定其全部来源。观点引用始终展开正文。"
          }
        },
        "required": [
          "ref"
        ],
        "additionalProperties": false
      },
      "internal": {
        "executor": "thought",
        "operation": "thought_load"
      }
    },
    {
      "command": "thought_record",
      "summary": "收纳值得继续的疑问，也可以记录自主好奇。 自主窗口的新问题先作为搁置线索；旁支用parent_ref保留关系。",
      "parameters": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "origin": {
            "type": "string",
            "enum": [
              "user_request",
              "conversation",
              "memory",
              "review",
              "interest",
              "exploration"
            ]
          },
          "parent_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "activity": {
            "type": "string",
            "enum": [
              "interest",
              "problem",
              "iteration"
            ],
            "description": "该疑问所属活动：兴趣探索、问题思考、自我迭代。"
          },
          "importance": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3,
            "description": "当前判断的持续价值，0–3。"
          },
          "urgency": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3,
            "description": "当前判断的紧迫度，0–3。"
          },
          "due_at": {
            "type": "number",
            "minimum": 0,
            "maximum": 253402300799,
