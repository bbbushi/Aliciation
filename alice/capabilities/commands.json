{
  "version": 12,
  "units": [
    {
      "command": "reply_detail",
      "summary": "仅在当前用户明确追问某条已保存回答的过程或反省时读取一栏。使用宿主列出的回复轮次，引用当前用户原话。可用材料未曾发布，无结果时按已有证据回答。",
      "parameters": {
        "type": "object",
        "properties": {
          "turn_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "section": {
            "type": "string",
            "enum": [
              "task_process",
              "reflection"
            ]
          },
          "user_quote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        },
        "required": [
          "turn_id",
          "section",
          "user_quote"
        ],
        "additionalProperties": false
      },
      "internal": {
        "executor": "reply_detail",
        "operation": "reply_detail"
      }
    },
    {
      "command": "recall",
      "summary": "检索并读取获准使用的本机记忆。",
      "parameters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "检索关键词或短语"
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      },
      "internal": {
        "executor": "ordinary",
        "operation": "recall"
      }
    },
    {
      "command": "remember",
      "summary": "择要保存用户事实或约定，带来源内容按见闻保存。",
      "parameters": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "短标题，≤12字"
          },
          "content": {
            "type": "string",
            "description": "要记住的完整内容。来自网页时用你自己的话转写并标明来源（如「维基百科条目说：…」），不要照抄原文"
          },
          "keywords": {
            "type": "string",
            "description": "可选，检索关键词，空格分隔"
          },
          "source_url": {
            "type": "string",
            "description": "可选。内容来源的网页链接；提供则保存为带出处的见闻记忆（走普通记忆管线）"
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "本轮真实来源的packet_id；填写子集不能解除其他可见来源依赖"
          }
        },
        "required": [
          "title",
          "content"
        ],
        "additionalProperties": false
      },
      "internal": {
        "executor": "ordinary",
        "operation": "remember"
      }
    },
    {
      "command": "discovery_search",
      "summary": "搜索并读取公开网页，默认全网，可限定已开放的平台；结果以实际读取的正文节选与来源为准。",
      "parameters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "主题名加少量关键实体；不要堆叠最新/近期等泛词。无合适结果时可缩短或调整关键词"
          },
          "platform": {
            "type": "string",
            "enum": [
              "auto",
              "web",
              "tieba",
              "bilibili",
              "zhihu",
              "wikipedia"
            ],
            "description": "省略或auto均使用web全网；仅在用户要求特定平台时选择对应平台。各范围须已获准，关闭全网时不自动退回平台搜索。"
          },
          "limit": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "description": "用户指定单篇条目时用1，避免引入不需要的其他页面"
          },
          "fresh": {
            "type": "boolean",
            "description": "true仅表示重新联网、不复用本地搜索缓存，不保证帖子新；近期信息同时使用published_after与recent排序"
          },
          "sort": {
            "type": "string",
            "enum": [
              "recent",
              "relevance"
            ],
            "description": "贴吧默认recent按发帖时间优先；查历史背景可用relevance。其他平台保持自身排序"
          },
          "published_after": {
            "type": [
              "string",
              "null"
            ],
            "description": "贴吧主帖发布日期下限（含当天，YYYY-MM-DD，UTC+8）。近期话题按实际时间范围填写；不限定为null。日期未知不充作新帖；auto带日期时只查贴吧"
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      },
      "internal": {
        "executor": "search",
        "operation": "discovery_search"
      }
    },
    {
      "command": "memory_search",
      "summary": "搜索本机普通记忆索引。",
      "parameters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 500
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "cursor": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      },
      "internal": {
        "executor": "memory",
        "operation": "memory_search"
      }
    },
    {
      "command": "memory_load",
      "summary": "读取本轮记忆索引引用的正文。",
      "parameters": {
        "type": "object",
        "properties": {
          "refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 4
          }
        },
        "required": [
          "refs"
        ],
        "additionalProperties": false
      },
      "internal": {
        "executor": "memory",
        "operation": "memory_load"
      }
    },
    {
      "command": "history_search",
      "summary": "搜索当前渠道获准访问的旧对话索引；搜索与正文读取分别计次。",
      "parameters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 500
          },
          "cursor": {
            "type": [
              "string",
